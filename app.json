{
  "expo": {
    "name": "Rapid Money",
    "slug": "rapidmoney-internal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rapid-money-app-logo.png",
    "splash": {
      "image": "./assets/images/rapid-money-app-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "scheme": "rapid-money",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rapidmoney.internal",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is required for selfie verification."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/rapid-money-app-logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rapidmoney.internal",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rapidmoney.app.link"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rapidmoney-alternate.app.link"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rapidmoney.test-app.link"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rapidmoney-alternate.test-app.link"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/rapid-money-logo.png"
    },
    "plugins": [
      "./plugins/withBranch",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/rapid-money-app-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-navigation-bar",
      "expo-video",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b08d9fdf-c8ff-424c-97a8-ba8f57d94955"
      }
    }
  }
}
