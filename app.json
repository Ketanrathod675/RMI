{
  "expo": {
    "name": "Rapid Money",
    "slug": "rapidmoney-internal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rapid-money-app-logo.png",
    "scheme": "rapid-money",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rapidmoney.internal",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is required for liveness verification."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/rapid-money-app-logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rapidmoney.internal",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/rapid-money-logo.png"
    },
    "plugins": [
      "expo-router",
      // [
      //   "expo-splash-screen",
      //   {
      //     "image": "./assets/images/rapid-money-logo.png",
      //     "imageWidth": 120,
      //     "resizeMode": "contain",
      //     "backgroundColor": "#ffffff"
      //   }
      // ],
      "@react-native-community/datetimepicker",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Camera access is required for liveness verification."
        }
      ],
      "expo-navigation-bar",
      "expo-video",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b08d9fdf-c8ff-424c-97a8-ba8f57d94955"
      }
    }
  }
}